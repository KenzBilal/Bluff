<resources>
    <style name="Theme.Bluff.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#080808</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Bluff</item>
    </style>

    <style name="Theme.Bluff" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#080808</item>
    </style>
</resources>